{
 "uctf": 2,
 "name": "toy",
 "description": "A made-up 1,200-neuron network (make_toy.py) to show the format; not biological.",
 "connectome": {
  "source": "folder",
  "params": {
   "path": "toy"
  }
 },
 "transforms": [],
 "populations": {
  "IN": {
   "col": "cell_type",
   "equals": "IN"
  },
  "EXP": {
   "col": "cell_type",
   "equals": "EXP"
  },
  "OUT": {
   "col": "cell_type",
   "equals": "OUT"
  },
  "HUB": {
   "col": "cell_type",
   "equals": "HUB"
  }
 },
 "neuron": {
  "model": "lif",
  "params": {
   "dt": 0.02,
   "tau": 0.1,
   "threshold": 1.0,
   "reset": 0.0,
   "tonic": 0.05,
   "seed": 0
  }
 },
 "synapses": [
  {
   "layer": "chemical",
   "model": "chemical",
   "params": {
    "gain": 1.5
   }
  }
 ],
 "input": {
  "encoder": "random_subset",
  "population": "IN",
  "steps": 6,
  "params": {
   "active": 20,
   "drive": 1.5,
   "sustain": 0.5,
   "seed": 3
  }
 },
 "readout": [
  {
   "name": "exp",
   "feature": "counts",
   "population": "EXP",
   "params": {}
  },
  {
   "name": "out_v",
   "feature": "voltage",
   "population": "OUT",
   "params": {}
  },
  {
   "name": "hub_trace",
   "feature": "trace",
   "population": "HUB",
   "params": {
    "tau": 0.1
   }
  }
 ],
 "controls": {
  "rewire-full": [
   {
    "transform": "rewire",
    "params": {
     "layers": {
      "chemical": "permute_presynaptic",
      "electrical": "double_edge_swap"
     },
     "classes": null,
     "skip_missing": true
    }
   }
  ],
  "rewire-class": [
   {
    "transform": "rewire",
    "params": {
     "layers": {
      "chemical": "permute_presynaptic",
      "electrical": "double_edge_swap"
     },
     "classes": {
      "populations": [
       "IN",
       "EXP",
       "OUT",
       "HUB"
      ],
      "else_col": "cell_type"
     },
     "skip_missing": true
    }
   }
  ]
 },
 "activity_match": {
  "param": "synapses.chemical.params.gain",
  "readouts": [
   "exp"
  ]
 },
 "view": {
  "project": [
   "x",
   "z"
  ],
  "title": "Inside the toy network",
  "caption": "Each letter drives its own set of input cells; the expansion layer holds a short trace of recent letters.",
  "credit": "A made-up network from examples/toy_connectome; not biological.",
  "groups": [
   {
    "name": "IN",
    "population": "IN",
    "color": "#22d3ee",
    "text": "input"
   },
   {
    "name": "EXP",
    "population": "EXP",
    "color": "#facc15",
    "text": "expansion"
   },
   {
    "name": "OUT",
    "population": "OUT",
    "color": "#4ade80",
    "text": "output"
   }
  ],
  "labels": [
   {
    "text": "expansion layer",
    "population": "EXP",
    "half": "both"
   }
  ]
 }
}
